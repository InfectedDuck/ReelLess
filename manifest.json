{
  "manifest_version": 3,
  "minimum_chrome_version": "99",
  "name": "Block Shorts & Reels: YouTube, Instagram, TikTok, Facebook — ReelLess",
  "version": "2.3.0",
  "description": "Blocks YouTube Shorts, Instagram and Facebook Reels, and TikTok. Blocked pages stop in place. Offline, no account.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ReelLess",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://www.instagram.com/*",
        "https://m.instagram.com/*",
        "https://instagram.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://facebook.com/*",
        "https://fb.com/*",
        "https://www.fb.com/*",
        "https://fb.watch/*",
        "https://www.fb.watch/*",
        "https://www.tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "shared.js",
        "site_guard.js"
      ],
      "css": [
        "site_guard.css"
      ],
      "run_at": "document_start"
    }
  ]
}
